# ─────────────────────────────────────────────────────────────────────────────
# Muhammad Taha — Portfolio environment variables
# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. None of these use the NEXT_PUBLIC_ prefix on purpose:
# they are only read on the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin authentication ────────────────────────────────────────────────────
# Generate both values with:  npm run hash-password -- "your strong password"
ADMIN_EMAIL=tahasajjad678@gmail.com
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters (the command above prints one)
AUTH_SECRET=

# ── Database + file storage (Supabase) ─────────────────────────────────────
# Supabase → Project Settings → API. Use the *service_role* key (server only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio
# Local development without Supabase: "file" stores data in ./.data (not for Vercel)
# DATA_STORE=file

# ── Contact form email: Gmail (easiest) ───────────────────────────────────────
# Google Account → Security → 2-Step Verification ON → App passwords → create one.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Contact form email: Resend (alternative) ─────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_EMAIL=tahasajjad678@gmail.com
# Must use a domain verified in Resend for production.
# "onboarding@resend.dev" works for testing but can only deliver to the email
# address that owns the Resend account.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ── Portfolio AI assistant (optional) ───────────────────────────────────────
# Set any of these. They are tried in order (Gemini → OpenAI → Claude); if one
# fails the next is used. With none, the assistant still works using built-in
# answers generated from the portfolio content.
# Gemini key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated; the next model is tried if one is busy or unavailable.
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# ── GitHub (optional) ───────────────────────────────────────────────────────
# Fine-grained token with public read-only access. Raises the API rate limit
# from 60 to 5,000 requests/hour. Server-side only.
GITHUB_TOKEN=
GITHUB_USERNAME=tahashiekh573

# ── Shared rate limiting (optional, recommended) ────────────────────────────
# Upstash Redis REST credentials (free tier is enough). Without these, rate
# limits are tracked per serverless instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Site URL (optional) ─────────────────────────────────────────────────────
# Used for canonical URLs, sitemap and Open Graph. On Vercel the production URL
# is detected automatically; set this if you add a custom domain.
NEXT_PUBLIC_SITE_URL=
